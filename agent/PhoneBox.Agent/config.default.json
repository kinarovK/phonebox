{
  // PhoneBox settings. Easiest to edit from the tray icon > Settings (http://127.0.0.1:8765).
  // Manual edits are picked up on the next request; no restart needed.

  // Only use the phone with this serial number (null = every connected Android device)
  "deviceSerial": null,
  // Path to adb.exe (null = searched in PATH, the Android SDK and winget locations)
  "adbPath": null,

  // Weather location (Open-Meteo, no API key required) and the temperature unit: "celsius" or "fahrenheit"
  "weather": { "city": "Tallinn", "lat": 59.437, "lon": 24.745, "unit": "celsius", "model": "" },

  // Claude Code chats in the sessions widget. Both are off, because they come from your prompts: "shareSessionTitles" shows each
  // chat's title on the phone (without it only the folder name is shown and no title is read); "shareConversation" lets the phone
  // open a session's recent messages and steps (nothing is read from a chat file and nothing is sent).
  "claude": { "shareSessionTitles": false, "shareConversation": false },

  // Ping target for the ping metric and the "ping high" rule, every 5 s (empty = off)
  "ping": { "host": "1.1.1.1", "adapters": [] },
  // Cursor agent chats on the AI sessions widget (off by default)
  "cursor": { "sessions": false },
  // Antigravity chats on the AI sessions widget (off by default)
  "antigravity": { "sessions": false, "shareSessionTitles": false },
  // Live Codex quotas read through the Codex CLI (off by default; Settings › General › AI quotas & CodexBar)
  "codexBar": { "codexLiveQuota": false },
  // OpenCode permission prompts on the phone: Allow (once or always) and Deny, read from OpenCode's
  // background service on 127.0.0.1. Off by default: set "phoneApprovals": true (or Settings › General) to let
  // the phone answer. "watchWsl" adds OpenCode inside running WSL distros, "shareSessionTitles" the session titles.
  "opencode": { "phoneApprovals": false, "sessions": false, "timeoutSec": 90, "alwaysCountdownSec": 10, "watchWsl": false, "shareSessionTitles": false },

  // Night mode: between these times the screen dims and only the clock stays. Tap to wake it for 30 s.
  "night": { "enabled": true, "start": "00:30", "end": "07:30", "brightness": 0.02 },

  // Clock seconds, return to the first page after N idle seconds (0 = never), vibrate on session events, a message when a session finishes,
  // switch pages with the phone's volume keys
  "display": { "showSeconds": true, "idleReturnSec": 90, "vibrate": true, "finishToast": true, "volumeKeys": true, "pixelShift": false, "controlsTop": false, "idleDimMin": 0, "nightWhenUnreachable": false, "unreachableNightDelayMin": 5, "language": "auto" },

  // Photo frame widget: "source" is "folder" or "immich". A folder source shows "folder" (empty = off) and whether subfolders count;
  // an Immich source shows one album ("immichAlbum" is its id) of the server at "immichUrl", read with the API key "immichKey". None of these go to the phone.
  "photos": { "source": "folder", "folder": "", "subfolders": true, "immichUrl": "", "immichKey": "", "immichAlbum": "", "immichAlbumName": "" },
  // IP cameras for the Camera widget: { "id", "name", "url": "rtsp://user:password@host:554/…", "transport": "tcp" | "udp", "fps": 1 to 10 (5) }.
  // "ffmpeg": its full path, or empty to find it in PATH. The addresses never go to the phone.
  "cameras": { "ffmpeg": "", "sources": [] },

  // Pages in the order they appear on the phone. Each page is a 12 x 6 grid of widgets; the settings page has a
  // visual editor. { "template": "<id>" } creates a page from templates.json (home, ai, work, system, procs, deck,
  // music, clock, focus, world, dashboard, devops, feeds, ambient, markets, daily, status, calm) and is replaced by
  // its widgets on the first save.
  "pages": [
    { "template": "home" },
    { "template": "ai" },
    { "template": "work" },
    { "template": "system" },
    { "template": "procs" },
    { "template": "focus", "enabled": false },
    { "template": "world", "enabled": false }
  ]
}
